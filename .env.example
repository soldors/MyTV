# 站长密码（登录鉴权，派生会话签名）
PASSWORD=

# 代理/会话签名密钥（不设置时从 PASSWORD 派生；多实例建议显式设置）
PROXY_SECRET=

# 站点名称
NEXT_PUBLIC_SITE_NAME=MyTV

# M0 阶段：预置采集源（JSON 数组，与上游 LibreTV 命名一致）
# 格式：[{"name":"量子资源","url":"https://cj.lziapi.com/api.php/provide/vod"}]
# DEFAULT_SOURCES=

# 预置数据源订阅（JSON 数组，元素为 URL 或 {url,name}）
# DEFAULT_SUBSCRIPTIONS=

# 预置采集源（M2 前台数据源；线上经 wrangler.toml [vars] 配置，本地放 .dev.vars）
# 格式：[{"name":"量子资源","url":"https://cj.lziapi.com/api.php/provide/vod"}]
# DEFAULT_SOURCES=

# —— M3 缓存与熔断（可选，括号内为默认值） ——
# 搜索 KV 缓存 TTL 秒（1800 = 30 分钟；高频词第 2 次出现才写 KV）
# SEARCH_CACHE_TTL_SECONDS=1800
# 详情 KV 缓存 TTL 秒（21600 = 6 小时）
# DETAIL_CACHE_TTL_SECONDS=21600
# 连续失败多少次触发熔断（3）
# CIRCUIT_FAILURE_THRESHOLD=3
# 熔断持续毫秒数（300000 = 5 分钟）
# CIRCUIT_OPEN_MS=300000

# 预置直播源（M5；线上经 wrangler.toml [vars] 配置）
# 格式：[{"name":"源名","url":"https://.../list.m3u","epg":"https://.../epg.xml.gz"}]
# DEFAULT_LIVE_SOURCES=
