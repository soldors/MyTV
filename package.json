{
  "name": "mytv",
  "version": "0.0.1",
  "private": true,
  "description": "MyTV - 在线影视聚合平台（Cloudflare Workers / 苹果CMS 采集）",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
